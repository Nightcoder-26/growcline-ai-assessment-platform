backend/*.py[cod]
backend/*$py.class

# Database files
backend/*.db
backend/*.sqlite3

# Environment variables
backend/.env
backend/.venv/
backend/venv/
backend/env/
backend/ENV/
backend/env.bak/
backend/venv.bak/


